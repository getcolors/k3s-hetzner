# -*- mode: sh; sh-shell: bash -*-

export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv 2>/dev/null

# This file is safe to commit: all provider credentials live in the gitignored
# .envrc.private file. Run `direnv allow` once to activate the environment.
#
# Never export COLORS_PAR_PROFILE. The profile separates this deployment's
# remote state from every other project using the shared R2 bucket.
source_env_if_exists .envrc.private
